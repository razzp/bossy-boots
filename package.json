{
    "name": "bossy-boots",
    "author": "Robert Wells",
    "version": "1.0.1",
    "description": "A helpful collection of type guards and assertions, written in TypeScript.",
    "keywords": [
        "assert",
        "assertion",
        "guard",
        "guards",
        "guarding",
        "type",
        "typescript",
        "javascript",
        "utilities",
        "utility",
        "helpers",
        "helper",
        "library",
        "strict"
    ],
    "license": "MIT",
    "bugs": "https://github.com/razzp/bossy-boots/issues",
    "homepage": "https://github.com/razzp/bossy-boots#readme",
    "repository": "github:razzp/bossy-boots",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/main.cjs",
    "module": "./dist/main.js",
    "exports": {
        ".": {
            "import": "./dist/main.js",
            "require": "./dist/main.cjs"
        }
    },
    "types": "./dist/main.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rimraf dist && rollup --config && npm run types",
        "biome": "biome check --write",
        "types": "rimraf types && tsc --project tsconfig.types.json && api-extractor run --local --verbose",
        "test": "jest --verbose --coverage",
        "docs": "api-documenter markdown --input-folder temp --output-folder docs",
        "prepublishOnly": "npm run test"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.2",
        "@microsoft/api-documenter": "^7.27.3",
        "@microsoft/api-extractor": "^7.53.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/jest": "^30.0.0",
        "@types/jsdom": "^27.0.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "jsdom": "^27.0.1",
        "rimraf": "^6.0.1",
        "rollup": "^4.52.5",
        "ts-jest": "^29.4.5",
        "typescript": "~5.9.3"
    },
    "dependencies": {
        "tslib": "^2.8.1"
    }
}
